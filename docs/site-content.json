{
  "schema": 1,
  "repository": "rizonesoft/RasterFold",
  "visibility": "public",
  "base_path": "/RasterFold/",
  "site_url": "https://rizonesoft.github.io/RasterFold/",
  "build_type": "workflow",
  "https_enforced": true,
  "environment": {
    "name": "github-pages",
    "custom_branch_policies": true,
    "allowed_branches": [
      "main"
    ],
    "release_trigger": {
      "event": "workflow_dispatch",
      "dispatch_branch": "main",
      "supports_exact_release_ref": true
    }
  },
  "config": [
    {
      "source": "docs/_config.yml",
      "staged": "_config.yml"
    },
    {
      "source": "docs/_includes/components/footer.html",
      "staged": "_includes/components/footer.html"
    },
    {
      "source": "docs/_includes/head_custom.html",
      "staged": "_includes/head_custom.html"
    },
    {
      "source": "docs/_includes/header_custom.html",
      "staged": "_includes/header_custom.html"
    },
    {
      "source": "docs/404.md",
      "staged": "404.md"
    },
    {
      "source": "docs/_includes/generated/charts/corpus-size-ratio.svg",
      "staged": "_includes/generated/charts/corpus-size-ratio.svg"
    },
    {
      "source": "docs/_includes/generated/charts/benchmark-size-ratio.svg",
      "staged": "_includes/generated/charts/benchmark-size-ratio.svg"
    },
    {
      "source": "docs/_includes/generated/charts/encode-time.svg",
      "staged": "_includes/generated/charts/encode-time.svg"
    },
    {
      "source": "docs/_includes/generated/charts/decode-time.svg",
      "staged": "_includes/generated/charts/decode-time.svg"
    },
    {
      "source": "docs/_includes/generated/charts/peak-memory.svg",
      "staged": "_includes/generated/charts/peak-memory.svg"
    },
    {
      "source": "docs/_includes/generated/charts/scatter-e9.svg",
      "staged": "_includes/generated/charts/scatter-e9.svg"
    },
    {
      "source": "docs/_includes/generated/charts/size-vs-decode.svg",
      "staged": "_includes/generated/charts/size-vs-decode.svg"
    },
    {
      "source": "docs/_includes/generated/tables/corpus-size-ratio.md",
      "staged": "_includes/generated/tables/corpus-size-ratio.md"
    },
    {
      "source": "docs/_includes/generated/tables/benchmark-size-ratio.md",
      "staged": "_includes/generated/tables/benchmark-size-ratio.md"
    },
    {
      "source": "docs/_includes/generated/tables/encode-time.md",
      "staged": "_includes/generated/tables/encode-time.md"
    },
    {
      "source": "docs/_includes/generated/tables/decode-time.md",
      "staged": "_includes/generated/tables/decode-time.md"
    },
    {
      "source": "docs/_includes/generated/tables/peak-memory.md",
      "staged": "_includes/generated/tables/peak-memory.md"
    },
    {
      "source": "docs/_includes/generated/tables/scatter-e9.md",
      "staged": "_includes/generated/tables/scatter-e9.md"
    },
    {
      "source": "docs/_includes/generated/tables/size-vs-decode.md",
      "staged": "_includes/generated/tables/size-vs-decode.md"
    },
    {
      "source": "docs/_includes/generated/version-labels.md",
      "staged": "_includes/generated/version-labels.md"
    }
  ],
  "pages": [
    {
      "id": "overview",
      "source": "docs/index.md",
      "staged": "index.md",
      "title": "Overview",
      "nav_order": 1,
      "kind": "authored"
    },
    {
      "id": "getting-started",
      "source": "docs/getting-started.md",
      "staged": "getting-started.md",
      "title": "Getting Started",
      "nav_order": 2,
      "kind": "authored"
    },
    {
      "id": "installation",
      "source": "docs/building.md",
      "output": "docs/installation.md",
      "staged": "installation.md",
      "title": "Installation and Build",
      "nav_order": 3,
      "kind": "mirrored"
    },
    {
      "id": "usage",
      "source": "README.md",
      "output": "docs/usage.md",
      "staged": "usage.md",
      "title": "CLI and Library Usage",
      "nav_order": 4,
      "kind": "mirrored"
    },
    {
      "id": "c-api",
      "source": "docs/library.md",
      "output": "docs/c-api.md",
      "staged": "c-api.md",
      "title": "C API Guide",
      "nav_order": 5,
      "kind": "mirrored"
    },
    {
      "id": "format",
      "source": "spec/FOLD.md",
      "output": "docs/format.md",
      "staged": "format.md",
      "title": "Format Specification",
      "nav_order": 6,
      "kind": "mirrored"
    },
    {
      "id": "examples",
      "source": "docs/examples.md",
      "staged": "examples.md",
      "title": "Examples",
      "nav_order": 7,
      "kind": "authored"
    },
    {
      "id": "benchmarks",
      "source": "docs/benchmarks.md",
      "staged": "benchmarks.md",
      "title": "Benchmarks",
      "nav_order": 8,
      "kind": "authored"
    },
    {
      "id": "research-summary",
      "source": "docs/research.md",
      "output": "docs/research-summary.md",
      "staged": "research-summary.md",
      "title": "Research Summary",
      "nav_order": 9,
      "kind": "mirrored"
    },
    {
      "id": "limitations",
      "source": "docs/limitations.md",
      "staged": "limitations.md",
      "title": "Limitations",
      "nav_order": 10,
      "kind": "authored"
    },
    {
      "id": "troubleshooting",
      "source": "docs/troubleshooting.md",
      "staged": "troubleshooting.md",
      "title": "Troubleshooting",
      "nav_order": 11,
      "kind": "authored"
    },
    {
      "id": "contributing",
      "source": "CONTRIBUTING.md",
      "output": "docs/contributing.md",
      "staged": "contributing.md",
      "title": "Contributing",
      "nav_order": 12,
      "kind": "mirrored"
    },
    {
      "id": "security",
      "source": "SECURITY.md",
      "output": "docs/security.md",
      "staged": "security.md",
      "title": "Security Policy",
      "nav_order": 13,
      "kind": "mirrored"
    },
    {
      "id": "licenses",
      "source": "docs/licenses.md",
      "staged": "licenses.md",
      "title": "Licenses and Provenance",
      "nav_order": 14,
      "kind": "authored"
    },
    {
      "id": "api",
      "source": "include/rasterfold.h",
      "output": "docs/api.md",
      "staged": "api.md",
      "title": "API Reference",
      "nav_order": 15,
      "kind": "generated"
    },
    {
      "id": "cli",
      "source": "src/main.c",
      "output": "docs/cli.md",
      "staged": "cli.md",
      "title": "Command-Line Reference",
      "nav_order": 16,
      "kind": "generated"
    },
    {
      "id": "downloads",
      "source": "docs/releases.json",
      "output": "docs/downloads.md",
      "staged": "downloads.md",
      "title": "Downloads",
      "nav_order": 17,
      "kind": "generated"
    },
    {
      "id": "release-history",
      "source": "CHANGELOG.md",
      "output": "docs/release-history.md",
      "staged": "release-history.md",
      "title": "Release History",
      "nav_order": 18,
      "kind": "mirrored"
    }
  ],
  "assets": [
    {
      "source": "assets/brand/icon.svg",
      "staged": "assets/brand/icon.svg"
    },
    {
      "source": "assets/brand/cover.svg",
      "staged": "assets/brand/cover.svg"
    },
    {
      "source": "docs/assets/css/site-states.css",
      "staged": "assets/css/site-states.css"
    },
    {
      "source": "docs/assets/js/site-states.js",
      "staged": "assets/js/site-states.js"
    }
  ],
  "forbidden_prefixes": [
    "todo/",
    ".agents/",
    ".claude/",
    ".codex/",
    ".conclave/",
    ".intelligence/",
    "docs/reviews/",
    "docs/phase-runs/",
    "AGENTS.md",
    "GEMINI.md",
    "CLAUDE.md"
  ]
}
