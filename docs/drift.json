{
  "schema": 1,
  "coverage": [
    {
      "pattern": "*/todo-template.md",
      "role": "template",
      "reason": "Placeholders are authoring examples, not current facts."
    },
    {
      "pattern": "docs/_includes/*",
      "role": "template",
      "reason": "Jekyll HTML layout includes with Liquid expressions."
    },
    {
      "pattern": "docs/wsl-migration-audit.md",
      "role": "historical",
      "reason": "Dated migration evidence; source changes do not rewrite past proof."
    },
    {
      "pattern": "docs/todo-vision-audit.md",
      "role": "historical",
      "reason": "Dated TODO audit evidence, with explicit current versus proposed boundaries."
    },
    {
      "pattern": "docs/measurements.md",
      "role": "historical",
      "reason": "Historical measurements retain their original conditions."
    },
    {
      "pattern": "docs/research.md",
      "role": "historical",
      "reason": "Dated research results and forward roadmap; live generated portions are checked separately."
    },
    {
      "pattern": "docs/research-summary.md",
      "role": "historical",
      "reason": "Mirrored public summary of dated research results from docs/research.md, checked by scripts/build-docs.py --check."
    },
    {
      "pattern": "docs/format.md",
      "role": "generated",
      "reason": "Mirrored format specification from spec/FOLD.md, checked by scripts/build-docs.py --check."
    },
    {
      "pattern": "docs/usage.md",
      "role": "generated",
      "reason": "Mirrored CLI and library usage guide from README.md, checked by scripts/build-docs.py --check."
    },
    {
      "pattern": "docs/reviews/*",
      "role": "historical",
      "reason": "Immutable review evidence and candidate references."
    },
    {
      "pattern": "docs/phase-runs/*",
      "role": "historical",
      "reason": "Run evidence is retained and never manufactured by repair."
    },
    {
      "pattern": "todo/*",
      "role": "plan",
      "reason": "Future requirements and measured Current state claims; never read future versions as current capabilities."
    },
    {
      "pattern": "docs/vision.md",
      "role": "plan",
      "reason": "Operator product contract; planned capabilities are labeled."
    },
    {
      "pattern": "docs/design/*",
      "role": "plan",
      "reason": "Surface specifications are planned behavior."
    },
    {
      "pattern": "benchmarks/*",
      "role": "data",
      "reason": "Measurements remain attached to their recorded conditions."
    },
    {
      "pattern": ".intelligence/*",
      "role": "historical",
      "reason": "Retained runner evidence, not generated documentation."
    },
    {
      "pattern": "*.json",
      "role": "configuration",
      "reason": "Structured JSON validated; facts.json is also reproduced from sources."
    },
    {
      "pattern": "*.toml",
      "role": "configuration",
      "reason": "Structured TOML validated."
    },
    {
      "pattern": "*.yml",
      "role": "configuration",
      "reason": "Workflow information and declared fact/claim bindings are checked."
    },
    {
      "pattern": "*.yaml",
      "role": "configuration",
      "reason": "Configuration information and declared fact/claim bindings are checked."
    },
    {
      "pattern": "*",
      "role": "current",
      "reason": "All other supported tracked or newly added text receives claim, fact and applicable link checks."
    }
  ],
  "facts": {
    "product_name": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"(RasterFold) lossless image codec\" RF_EOL$"
    },
    "format_name": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^\\s*rf_print\\(0, \"RasterFold (fold) version \\d+\" RF_EOL\\);$"
    },
    "format_version": {
      "kind": "regex",
      "source": "src/rf.h",
      "pattern": "^#define RF_VERSION (\\d+)[uUlL]*$",
      "type": "int",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "^\\s*rf_print\\(0, \"RasterFold fold version (\\d+)\" RF_EOL\\);$"
        }
      ]
    },
    "header_bytes": {
      "kind": "regex",
      "source": "src/rf.h",
      "pattern": "^#define RF_HEADER_SIZE (\\d+)[uUlL]*$",
      "type": "int"
    },
    "max_dimension": {
      "kind": "regex",
      "source": "src/rf.h",
      "pattern": "^#define RF_MAX_DIM (\\d+)[uUlL]*$",
      "type": "int"
    },
    "max_pixels": {
      "kind": "regex",
      "source": "src/rf.h",
      "pattern": "^#define RF_MAX_PIXELS (\\d+)[uUlL]*$",
      "type": "int"
    },
    "max_file_bytes": {
      "kind": "regex",
      "source": "src/rf.h",
      "pattern": "^#define RF_MAX_FILE (\\d+)[uUlL]*$",
      "type": "int"
    },
    "api_major": {
      "kind": "regex",
      "source": "include/rasterfold.h",
      "pattern": "^#define RF_API_VERSION_MAJOR (\\d+)[uUlL]*$",
      "type": "int"
    },
    "api_minor": {
      "kind": "regex",
      "source": "include/rasterfold.h",
      "pattern": "^#define RF_API_VERSION_MINOR (\\d+)[uUlL]*$",
      "type": "int"
    },
    "exit_ok": {
      "kind": "regex",
      "source": "include/rasterfold.h",
      "pattern": "^#define RF_OK (\\d+)$",
      "type": "int",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "^    \"exit codes: (\\d+) ok, \\d+ usage, \\d+ io, \\d+ unsupported, \\d+ malformed, \\d+ limit\" RF_EOL;$"
        }
      ]
    },
    "exit_ok_meaning": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"exit codes: 0 ([a-z]+), 1 [a-z]+, 2 [a-z]+, 3 [a-z]+, 4 [a-z]+, 5 [a-z]+\" RF_EOL;$"
    },
    "exit_usage": {
      "kind": "regex",
      "source": "include/rasterfold.h",
      "pattern": "^#define RF_ERR_USAGE (\\d+)$",
      "type": "int",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "^    \"exit codes: \\d+ ok, (\\d+) usage, \\d+ io, \\d+ unsupported, \\d+ malformed, \\d+ limit\" RF_EOL;$"
        }
      ]
    },
    "exit_usage_meaning": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"exit codes: 0 [a-z]+, 1 ([a-z]+), 2 [a-z]+, 3 [a-z]+, 4 [a-z]+, 5 [a-z]+\" RF_EOL;$"
    },
    "exit_io": {
      "kind": "regex",
      "source": "include/rasterfold.h",
      "pattern": "^#define RF_ERR_IO (\\d+)$",
      "type": "int",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "^    \"exit codes: \\d+ ok, \\d+ usage, (\\d+) io, \\d+ unsupported, \\d+ malformed, \\d+ limit\" RF_EOL;$"
        }
      ]
    },
    "exit_io_meaning": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"exit codes: 0 [a-z]+, 1 [a-z]+, 2 ([a-z]+), 3 [a-z]+, 4 [a-z]+, 5 [a-z]+\" RF_EOL;$"
    },
    "exit_unsupported": {
      "kind": "regex",
      "source": "include/rasterfold.h",
      "pattern": "^#define RF_ERR_UNSUPPORTED (\\d+)$",
      "type": "int",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "^    \"exit codes: \\d+ ok, \\d+ usage, \\d+ io, (\\d+) unsupported, \\d+ malformed, \\d+ limit\" RF_EOL;$"
        }
      ]
    },
    "exit_unsupported_meaning": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"exit codes: 0 [a-z]+, 1 [a-z]+, 2 [a-z]+, 3 ([a-z]+), 4 [a-z]+, 5 [a-z]+\" RF_EOL;$"
    },
    "exit_malformed": {
      "kind": "regex",
      "source": "include/rasterfold.h",
      "pattern": "^#define RF_ERR_FORMAT (\\d+)$",
      "type": "int",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "^    \"exit codes: \\d+ ok, \\d+ usage, \\d+ io, \\d+ unsupported, (\\d+) malformed, \\d+ limit\" RF_EOL;$"
        }
      ]
    },
    "exit_malformed_meaning": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"exit codes: 0 [a-z]+, 1 [a-z]+, 2 [a-z]+, 3 [a-z]+, 4 ([a-z]+), 5 [a-z]+\" RF_EOL;$"
    },
    "exit_limit": {
      "kind": "regex",
      "source": "include/rasterfold.h",
      "pattern": "^#define RF_ERR_LIMIT (\\d+)$",
      "type": "int",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "^    \"exit codes: \\d+ ok, \\d+ usage, \\d+ io, \\d+ unsupported, \\d+ malformed, (\\d+) limit\" RF_EOL;$"
        }
      ]
    },
    "exit_limit_meaning": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"exit codes: 0 [a-z]+, 1 [a-z]+, 2 [a-z]+, 3 [a-z]+, 4 [a-z]+, 5 ([a-z]+)\" RF_EOL;$"
    },
    "cmd_encode": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"  rasterfold (encode) \\[--time\\] \\[--threads N\\] input\\.bmp output\\.fold\" RF_EOL$",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "int encode = wide_eq\\(pos\\[0\\], \"(encode)\"\\)"
        }
      ]
    },
    "cmd_decode": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"  rasterfold (decode) \\[--time\\] \\[--threads N\\] input\\.fold output\\.bmp\" RF_EOL$",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "decode = wide_eq\\(pos\\[0\\], \"(decode)\"\\)"
        }
      ]
    },
    "cmd_inspect": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"  rasterfold (inspect) \\[--time\\] input\\.fold\" RF_EOL$",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "inspect = wide_eq\\(pos\\[0\\], \"(inspect)\"\\)"
        }
      ]
    },
    "input_image_ext": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"  rasterfold encode \\[--time\\] \\[--threads N\\] input(\\.bmp) output\\.fold\" RF_EOL$",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "^    \"  rasterfold decode \\[--time\\] \\[--threads N\\] input\\.fold output(\\.bmp)\" RF_EOL$"
        }
      ]
    },
    "encoded_ext": {
      "kind": "regex",
      "source": "src/main.c",
      "pattern": "^    \"  rasterfold encode \\[--time\\] \\[--threads N\\] input\\.bmp output(\\.fold)\" RF_EOL$",
      "also_match": [
        {
          "source": "src/main.c",
          "pattern": "^    \"  rasterfold decode \\[--time\\] \\[--threads N\\] input(\\.fold) output\\.bmp\" RF_EOL$"
        },
        {
          "source": "src/main.c",
          "pattern": "^    \"  rasterfold inspect \\[--time\\] input(\\.fold)\" RF_EOL$"
        }
      ]
    },
    "measurement_reference_bytes": {
      "kind": "csv",
      "source": "benchmarks/results.csv",
      "where": {
        "set": "measure",
        "image": "image",
        "codec": "rasterfold"
      },
      "column": "bytes",
      "type": "int"
    }
  },
  "blocks": {
    "readme-capabilities": {
      "path": "README.md",
      "template": "Current codec: format {format_version}, C API {api_major}.{api_minor}, RGB8. Maximum dimension: {max_dimension}; maximum image: {max_pixels} pixels. The native converter and full Pages site are planned in [the product vision](docs/vision.md)."
    },
    "build-capabilities": {
      "path": "docs/building.md",
      "template": "The sources currently declare format {format_version}, API {api_major}.{api_minor}, a {max_dimension}-pixel dimension limit and a {max_pixels}-pixel image limit. See [the document drift policy](document-drift.md) for validation and repair."
    },
    "api-capabilities": {
      "path": "docs/library.md",
      "template": "Current public API: {api_major}.{api_minor}. Current encoded format: {format_version}. Image limits: {max_dimension} pixels per dimension and {max_pixels} pixels total. These values are generated from the C headers."
    }
  },
  "assertions": [
    {
      "pattern": "*",
      "regex": "\\b(?:(?:encoded |codec: |declare )format:? |format (?:version |v))(\\d+(?:[.,_]\\d+)*)\\b",
      "fact": "format_version"
    },
    {
      "pattern": "*",
      "regex": "\\b(?:public )?API:? (?:version )?(\\d+)\\.\\d+(?![.,_]\\d)\\b",
      "fact": "api_major"
    },
    {
      "pattern": "*",
      "regex": "\\b(?:public )?API:? (?:version )?\\d+\\.(\\d+(?:[.,_]\\d+)*)\\b",
      "fact": "api_minor"
    },
    {
      "pattern": "*",
      "regex": "\\b(?:maximum dimension:? |dimension limit:? )(\\d+(?:[.,_]\\d+)*)\\b",
      "fact": "max_dimension"
    },
    {
      "pattern": "*",
      "regex": "\\b(\\d+(?:[.,_]\\d+)*)(?:-pixel dimension limit| pixels per dimension)\\b",
      "fact": "max_dimension"
    },
    {
      "pattern": "*",
      "regex": "\\b(?:maximum image:? |image limit:? )(\\d+(?:[.,_]\\d+)*)\\b",
      "fact": "max_pixels"
    },
    {
      "pattern": "*",
      "regex": "\\b(\\d+(?:[.,_]\\d+)*)(?:-pixel image limit| pixels total)\\b",
      "fact": "max_pixels"
    },
    {
      "pattern": "*",
      "regex": "\\b(?:maximum file(?: size)?:? |file(?: size)? limit:? )(\\d+(?:[.,_]\\d+)*)(?:[ \\t]*([a-zA-Z]+))?\\b",
      "fact": "max_file_bytes",
      "units": "bytes"
    }
  ],
