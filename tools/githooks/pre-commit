#!/bin/sh
# pre-commit: refuse the commit when the staged tree fails TODO-graph validation.
# Validates the index (what will be committed) in a temp checkout; the worktree gets an advisory probe only, never a refusal.
# Installed per clone via `git config core.hooksPath tools/githooks` (tools/provision.ps1 sets it; see AGENTS.md).
set -u
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "pre-commit: not inside a git work tree" >&2; exit 1; }
cd "$ROOT" || { echo "pre-commit: cannot enter the work tree" >&2; exit 1; }
pick_python() {
  for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info[0] < 3)' 2>/dev/null; then
      printf '%s' "$c"; return 0
    fi
  done
  return 1
}
PY="$(pick_python)" || { echo "pre-commit: no working Python 3 (python3, python, or py) on PATH; install Python 3 so the TODO gate can run" >&2; exit 1; }
# Temp dir lives under the git dir so its path is native on every platform (no /tmp translation under Git Bash).
GITDIR="$(git rev-parse --absolute-git-dir 2>/dev/null)" || { echo "pre-commit: cannot locate the git dir" >&2; exit 1; }
WORK="$(mktemp -d "$GITDIR/hookgate.XXXXXX" 2>/dev/null)" || { echo "pre-commit: cannot make a temp dir" >&2; exit 1; }
cleanup() {
  # Windows briefly locks fresh files (antivirus, fsmonitor), so one rm -rf pass can
  # fail with "Device or resource busy" and litter the git dir; retry instead.
  n=0
  while [ -e "$WORK" ] && [ "$n" -lt 10 ]; do
    rm -rf "$WORK" 2>/dev/null && break
    n=$((n+1)); sleep 1
  done
  [ -e "$WORK" ] && echo "pre-commit: warning: could not remove $WORK" >&2
  return 0
}
trap 'cleanup' EXIT INT TERM
git checkout-index -a --prefix="$WORK/" || { echo "pre-commit: cannot stage the index for validation" >&2; exit 1; }
if [ -f "$WORK/scripts/todo-graph.py" ]; then
  (cd "$WORK" && "$PY" scripts/todo-graph.py validate) || { echo "pre-commit: todo-graph validate is red on the staged tree; fix the findings above and retry" >&2; exit 1; }
fi
if [ -f "$WORK/research/milestones.py" ]; then
  (cd "$WORK" && "$PY" research/milestones.py --check) || { echo "pre-commit: the milestone files drift from research/milestones.py; run python research/milestones.py --write and stage the result" >&2; exit 1; }
fi
git diff --quiet -- scripts todo docs || { "$PY" scripts/todo-graph.py validate >/dev/null 2>&1 || echo "pre-commit: warning: unstaged changes carry findings; this gate validated only the staged tree" >&2; }
exit 0
