#!/bin/sh
# Strip AI-assistant attribution from every commit message (operator decision 2026-09-28): no
# "Co-Authored-By:" trailer for Claude, Anthropic, or another AI assistant, and no "Generated with"
# footer, so GitHub never lists an assistant as a contributor. Human co-authors are kept.
msg="$1"
tmp="$msg.tmp.$$"
grep -v -i -E '^[[:space:]]*co-authored-by:.*(anthropic|claude|openai|chatgpt|copilot|gemini|codex)' "$msg" \
  | grep -v -i -E '(generated with|created with) \[?claude' > "$tmp"
# drop trailing blank lines left behind
sed -e ':a' -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmp" > "$msg"
rm -f "$tmp"
# Evaluate declared facts with the staged checker and staged source bytes.
# Unstaged repairs cannot hide a false declaration in the commit candidate.
ROOT="$(git rev-parse --show-toplevel)" || exit 1
GITDIR="$(git rev-parse --absolute-git-dir)" || exit 1
if git cat-file -e :scripts/drift-check.py 2>/dev/null; then
  PY=""
  for c in python3 python py; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
      PY="$c"; break
    fi
  done
  [ -n "$PY" ] || { echo "commit-msg: Python 3.11+ is required for document facts" >&2; exit 1; }
  CHECKER="$(mktemp "$GITDIR/drift-msg.XXXXXX")" || exit 1
  trap 'rm -f "$CHECKER"' EXIT
  trap 'rm -f "$CHECKER"; trap - EXIT; exit 129' HUP
  trap 'rm -f "$CHECKER"; trap - EXIT; exit 130' INT
  trap 'rm -f "$CHECKER"; trap - EXIT; exit 143' TERM
  git show :scripts/drift-check.py > "$CHECKER" || exit 1
  "$PY" "$CHECKER" --root "$ROOT" --commit-message "$msg" || exit 1
fi
exit 0
