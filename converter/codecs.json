      "settings": [
        {
          "id": "metadata",
          "type": "enum",
          "default": "preserve",
          "allowed": [
            "preserve",
            "strip"
          ],
          "refusal_reason": "metadata=strip is explicit; metadata is never dropped silently"
        },
        {
          "id": "exactness",
          "type": "enum",
          "default": "pixel-exact",
          "allowed": [
            "pixel-exact",
            "byte-identical"
          ],
          "refusal_reason": "exactness supports pixel-exact and byte-identical only: coefficient-exact needs JPEG DCT coefficients and original-byte-reconstruction needs JPEG XL reconstruction data, neither of which this format carries"
        }
      ],
      "rules": [
        {
          "setting_a": "metadata",
          "value_a": "strip",
          "setting_b": "exactness",
          "value_b": "byte-identical",
          "reason": "stripping metadata changes the bytes, so it cannot claim byte-identical exactness"
        }
      ],
