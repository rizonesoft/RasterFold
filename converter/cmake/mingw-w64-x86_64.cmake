set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

if(DEFINED RF_LLVM_MINGW_BIN)
  set(_rf_exe "")
  if(CMAKE_HOST_WIN32)
    set(_rf_exe ".exe")
  endif()
  set(CMAKE_C_COMPILER "${RF_LLVM_MINGW_BIN}/x86_64-w64-mingw32-clang${_rf_exe}" CACHE FILEPATH "")
  set(CMAKE_CXX_COMPILER "${RF_LLVM_MINGW_BIN}/x86_64-w64-mingw32-clang++${_rf_exe}" CACHE FILEPATH "")
  set(CMAKE_ASM_COMPILER "${RF_LLVM_MINGW_BIN}/x86_64-w64-mingw32-clang${_rf_exe}" CACHE FILEPATH "")
  set(CMAKE_RC_COMPILER "${RF_LLVM_MINGW_BIN}/x86_64-w64-mingw32-windres${_rf_exe}" CACHE FILEPATH "")
  set(CMAKE_AR "${RF_LLVM_MINGW_BIN}/llvm-ar${_rf_exe}" CACHE FILEPATH "")
  set(CMAKE_RANLIB "${RF_LLVM_MINGW_BIN}/llvm-ranlib${_rf_exe}" CACHE FILEPATH "")
  set(CMAKE_NM "${RF_LLVM_MINGW_BIN}/llvm-nm${_rf_exe}" CACHE FILEPATH "")
  set(CMAKE_STRIP "${RF_LLVM_MINGW_BIN}/llvm-strip${_rf_exe}" CACHE FILEPATH "")
endif()

if(DEFINED RF_NASM_EXECUTABLE)
  set(CMAKE_ASM_NASM_COMPILER "${RF_NASM_EXECUTABLE}" CACHE FILEPATH "")
endif()

set(CMAKE_C_FLAGS_INIT "-march=x86-64-v2")
set(CMAKE_CXX_FLAGS_INIT "-march=x86-64-v2")
set(CMAKE_ASM_FLAGS_INIT "-march=x86-64-v2")

set(CMAKE_FIND_ROOT_PATH "")
if(DEFINED RF_DEPS_PREFIX)
  list(APPEND CMAKE_FIND_ROOT_PATH "${RF_DEPS_PREFIX}")
endif()
if(DEFINED RF_LLVM_MINGW_SYSROOT)
  list(APPEND CMAKE_FIND_ROOT_PATH "${RF_LLVM_MINGW_SYSROOT}")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
