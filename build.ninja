# Compatibility front door. Target graphs are generated by scripts/build.py.
# PowerShell 7 is already required by the existing Claude campaign hook.
rule native
  command = pwsh -NoProfile -ExecutionPolicy Bypass -File build.ps1
  description = Build native CLI and libraries
rule pgo_gen
  command = pwsh -NoProfile -ExecutionPolicy Bypass -File build.ps1 --pgo-gen
  description = Build PGO-instrumented Windows CLI
build all: native
build pgo-gen: pgo_gen
default all
